1777252791307:run "val zero = '0'.toInt;\n\ndef printDigit(x: Int) = {\n  putchar(zero + x)\n};\n\ndef myPrintInt(x: Int) = { // only 1 digits!\n  if (x >= 0 && x <= 9)\n    printDigit(x)\n};\n\ndef isEvenRec(n: Int) : Int = {\n    if (n == 0) 1\n    else isOddRec(n - 1)\n};\n\ndef isOddRec(n: Int) : Int = {\n    if (n == 0) 0\n    else isEvenRec(n - 1)\n};\n\nvar pr = 9;\nif (isEvenRec(7)==1) pr = 4;\nmyPrintInt(pr);\nputchar(10);\n1"
